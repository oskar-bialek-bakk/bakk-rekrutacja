<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows App Service (IIS) hostuje tę aplikację jako pojedynczy plik index.html
  (build single-file, bez hashowanych assetów). Bez tego pliku IIS pozwala
  przeglądarce trzymać index.html w cache, więc nowy deploy był widoczny dopiero
  po twardym odświeżeniu (Ctrl+Shift+R). DisableCache wymusza rewalidację przy
  każdym wejściu, więc świeży deploy łapie się od razu przy zwykłym odświeżeniu.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
